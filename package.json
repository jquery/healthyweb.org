{
  "name": "healthyweb.org",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "astro": "astro",
    "build": "npm run clean && astro check && astro build",
    "clean": "rm -rf dist .astro .wrangler",
    "deploy": "npm run build && wrangler deploy",
    "dev": "astro dev",
    "format": "eslint . --fix && prettier --write .",
    "lint": "concurrently \"eslint .\" \"prettier --check .\" \"npm run typescript\"",
    "preview": "npm run clean && astro check && astro build && astro preview",
    "start": "npm run dev",
    "test": "astro check && npm run lint",
    "types": "wrangler types",
    "typescript": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/svelte": "^9.1.6",
    "@fontsource/roboto-slab": "^5.3.0",
    "astro": "^7.4.13",
    "svelte": "^5.58.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^2.0.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.73.0",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261117.1": true,
    "workerd@1.20261118.1": true
  }
}
