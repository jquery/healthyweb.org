{
  "name": "healthyweb.org",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "astro": "astro",
    "build": "npm run clean && astro check && astro build",
    "clean": "rm -rf dist .astro .wrangler",
    "deploy": "npm run build && wrangler deploy",
    "dev": "astro dev",
    "format": "eslint . --fix && prettier --write .",
    "lint": "concurrently \"eslint .\" \"prettier --check .\" \"npm run typescript\"",
    "preview": "npm run clean && astro check && astro build && astro preview",
    "start": "npm run dev",
    "test": "astro check && npm run lint",
    "types": "wrangler types",
    "typescript": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.1.3",
    "@astrojs/svelte": "^8.0.3",
    "@fontsource/roboto-slab": "^5.2.8",
    "astro": "^6.0.8",
    "svelte": "^5.54.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.0.6",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.57.1",
    "wrangler": "^4.76.0"
  }
}
